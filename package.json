    "@ag-grid-community/styles": "^32.3.3",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "decimal.js": "^10.6.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.468.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.1.12",
    "@paypal/agent-toolkit": "1.11.0",
    "@google/genai": "^1.30.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.6",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8",
    "tsx": "^4.20.6"
