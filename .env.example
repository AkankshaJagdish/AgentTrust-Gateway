# Use a dedicated local or disposable PostgreSQL database; do not commit a real URL.
DATABASE_URL="postgresql://agenttrust:replace-me@localhost:5432/agenttrust"
SESSION_SECRET="replace-with-32-or-more-random-bytes"
AGENT_SIGNING_SECRET="reserved-for-deployment-integrations"

# PayPal Developer sandbox REST app only. Keep secrets server-side.
PAYPAL_ENVIRONMENT="SANDBOX"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Optional PayPal receiving account merchant ID; separate from the local AgentTrust user ID.
PAYPAL_MERCHANT_ID=""
# Register the webhook URL in the PayPal Developer Dashboard and paste its webhook ID here.
PAYPAL_WEBHOOK_ID=""

# Optional AI policy assistant. Leave blank to keep all non-AI features available.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
APP_URL="http://localhost:3000"
# Optional explicit PayPal redirect URLs. If blank, APP_URL/RENDER_EXTERNAL_URL is used.
PAYPAL_RETURN_URL="http://localhost:3000/api/paypal/return"
PAYPAL_CANCEL_URL="http://localhost:3000/api/paypal/cancel"
# Register this exact public endpoint in the PayPal Developer Dashboard.
PAYPAL_WEBHOOK_URL="http://localhost:3000/api/paypal/webhook"
